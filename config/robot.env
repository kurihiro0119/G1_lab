# G1 接続設定 (scripts/*.sh が読み込む)
# 参考: https://techshare.co.jp/faq/unitree/unitree-g1-sdk.html

# G1 開発用内部PC (Jetson Orin)
G1_IP=192.168.123.164
G1_USER=unitree
# 内部PC上の配置先 (記事では /home/unitree/ts_ws)
G1_REMOTE_DIR=/home/unitree/ts_ws/G1_lab
# 内部PCから SDK を実行するときのネットワークIF
G1_IFACE=eth0

# Mac 側に設定する固定IP (192.168.123.0/24 の空きアドレス)
HOST_IP=192.168.123.212
